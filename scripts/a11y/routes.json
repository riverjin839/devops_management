{
  "_comment": "axe_scan.py 대상 라우트와 위반 위치 → 소스 파일 추정 표. routes[].auth=false 는 토큰 없이 연다(로그인 화면). regions 는 위반 노드의 랜드마크 경로(예: 'aside > nav[메인 네비게이션]')에 match 문자열이 들어 있으면 그 source 로 추정한다 — 위에서부터 첫 일치. source 가 '@page' 면 해당 라우트의 page 파일.",
  "routes": [
    { "id": "login", "path": "/", "auth": false, "page": "frontend/src/pages/LoginPage.tsx", "label": "로그인(토큰 없음)" },
    { "id": "home", "path": "/", "auth": true, "page": "frontend/src/pages/HomePage.tsx", "label": "홈" },
    { "id": "cluster-overview", "path": "/cluster-overview", "auth": true, "page": "frontend/src/pages/Dashboard.tsx", "label": "클러스터 개요" },
    { "id": "alerts", "path": "/alerts", "auth": true, "page": "frontend/src/pages/AlertInboxPage.tsx", "label": "알람 수신함" },
    { "id": "k8s-events", "path": "/k8s-events", "auth": true, "page": "frontend/src/pages/K8sEventsPage.tsx", "label": "K8s 이벤트" },
    { "id": "tasks-mgmt", "path": "/tasks-mgmt", "auth": true, "page": "frontend/src/pages/WorkItemBoardPage.tsx", "label": "업무 보드" },
    { "id": "docs", "path": "/docs", "auth": true, "page": "frontend/src/pages/KnowledgeHubPage.tsx", "label": "지식 허브" },
    { "id": "settings", "path": "/settings", "auth": true, "page": "frontend/src/pages/SettingsPage.tsx", "label": "설정" },
    { "id": "cluster-manage", "path": "/cluster-manage", "auth": true, "page": "frontend/src/pages/ClusterManagePage.tsx", "label": "클러스터 관리" },
    { "id": "versions", "path": "/versions", "auth": true, "page": "frontend/src/pages/VersionsPage.tsx", "label": "버전" },
    { "id": "ops-notes", "path": "/ops-notes", "auth": true, "page": "frontend/src/pages/OpsNotesPage.tsx", "label": "운영 노트" },
    { "id": "documents", "path": "/documents", "auth": true, "page": "frontend/src/pages/DocumentsPage.tsx", "label": "문서" },
    { "id": "playbooks", "path": "/playbooks", "auth": true, "page": "frontend/src/pages/PlaybooksPage.tsx", "label": "플레이북" },
    { "id": "scripts", "path": "/scripts", "auth": true, "page": "frontend/src/pages/ScriptsPage.tsx", "label": "스크립트" },
    { "id": "mindmap", "path": "/mindmap", "auth": true, "page": "frontend/src/pages/MindMapPage.tsx", "label": "마인드맵" },
    { "id": "weekly-report", "path": "/weekly-report", "auth": true, "page": "frontend/src/pages/WeeklyReportPage.tsx", "label": "주간보고" },
    { "id": "k8s-rbac", "path": "/k8s-rbac", "auth": true, "page": "frontend/src/pages/K8sRbacPage.tsx", "label": "K8s RBAC" },
    { "id": "node-specs", "path": "/node-specs", "auth": true, "page": "frontend/src/pages/NodeSpecPage.tsx", "label": "노드 사양" },
    { "id": "incident-analysis", "path": "/incident-analysis", "auth": true, "page": "frontend/src/pages/IncidentAnalysisPage.tsx", "label": "장애 분석" },
    { "id": "observability", "path": "/observability", "auth": true, "page": "frontend/src/pages/ObservabilityPage.tsx", "label": "관측" }
  ],
  "regions": [
    { "match": "aside[role=dialog]", "source": "frontend/src/components/common/SidePane.tsx" },
    { "match": "[role=dialog]", "source": "frontend/src/components/ui/dialog.tsx (또는 해당 화면의 Dialog 본문)" },
    { "match": "main > aside", "source": "frontend/src/components/common/ClusterSidebar.tsx" },
    { "match": "main", "source": "@page" },
    { "match": "nav[메인 네비게이션]", "source": "frontend/src/components/layout/Sidebar.tsx" },
    { "match": "nav[업무]", "source": "frontend/src/components/layout/AppTopBar.tsx" },
    { "match": "header", "source": "frontend/src/components/layout/AppTopBar.tsx" },
    { "match": "aside", "source": "frontend/src/components/layout/Sidebar.tsx" },
    { "match": "(body)", "source": "@page" }
  ]
}
