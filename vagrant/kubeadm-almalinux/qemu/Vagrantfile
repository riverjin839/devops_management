# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# 단일노드 kubeadm K8s (PEP 등록 + MinIO) — Apple Silicon, 무료 QEMU(vagrant-qemu).
#
# 왜 단일노드인가:
#   vagrant-qemu 는 macOS 에서 멀티노드 노드간 L2 통신이 안 된다(vmnet 은 root 권한
#   필요, 기본 user-mode/slirp 망은 VM 끼리 통신 불가). 따라서 QEMU 무료 경로는
#   "control-plane 1대(워크로드도 실행)"가 현실적이다. 멀티노드/worker 분리 디스크가
#   꼭 필요하면 상위 ../Vagrantfile + VMware Fusion 을 쓴다.
#
# 이 노드 한 대가:
#   - control-plane = schedulable (taint 제거) → MinIO 등 워크로드 직접 실행
#   - 추가 10GB 디스크 → /mnt/disks/minio (MinIO 로컬 PV)
#   - root SSH(비번) + dummy bond0/bond1 → Host Facts 충실도(상위 setup 과 동일)
#
# 네트워킹(user-mode/slirp + hostfwd):
#   - guest 22    → host 50022   (vagrant SSH)
#   - guest 6443  → host 6443    (kube-API; PEP 가 host.docker.internal:6443 으로 접속)
#   - guest 30900 → host 50090   (MinIO API)
#   - guest 30901 → host 50091   (MinIO Console)
#
# 사전 준비(한 번):
#   vagrant plugin install vagrant-qemu
#   brew install qemu
#   bash build-almalinux-box.sh        # AlmaLinux 10 → pep/almalinux10-qemu 박스 + seed.iso
#
# 기동:
#   vagrant up --provider=qemu
#   bash extract-kubeconfig.sh         # _out/ 로 kubeconfig 추출

require 'fileutils'

BOX           = "pep/almalinux10-qemu"   # build-almalinux-box.sh 가 만든 박스
NODE_IP       = "10.0.2.15"              # slirp 기본 게스트 IP (advertise/node-ip)
MEM           = "4G"
CPUS          = "2"
SSH_PORT      = "50022"
WORKER_DISK_GB = 10
ROOT_PASSWORD = "rootpass"               # build-almalinux-box.sh 의 ROOT_PW 와 일치

HERE     = File.dirname(__FILE__)
DISK_IMG = File.expand_path("minio.qcow2", HERE)   # 추가 디스크(부팅 전 생성)
SEED_IMG = File.expand_path("seed.iso",    HERE)   # cloud-init datasource

unless File.exist?(SEED_IMG)
  abort "[Vagrantfile] seed.iso 없음 — 먼저 'bash build-almalinux-box.sh' 를 실행하세요."
end

# MinIO 용 추가 디스크를 부팅 전에 생성(멱등).
unless File.exist?(DISK_IMG)
  system("qemu-img", "create", "-f", "qcow2", DISK_IMG, "#{WORKER_DISK_GB}G") \
    or abort "[Vagrantfile] qemu-img 로 #{DISK_IMG} 생성 실패 — 'brew install qemu' 확인"
end

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false
  config.vm.hostname = "k8s-control-1"

  # vagrant-qemu 는 synced folder(9p/rsync)가 불안정 → 끄고, 산출물은 SSH 로 추출한다.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.vm.provider "qemu" do |qe|
    qe.arch        = "aarch64"
    qe.machine     = "virt,accel=hvf,highmem=on"   # Apple Silicon HVF 가속
    qe.cpu         = "host"
    qe.smp         = CPUS
    qe.memory      = MEM
    qe.net_device  = "virtio-net-pci"
    qe.ssh_port    = SSH_PORT
    # SSH(자동) 외에 추가 포트포워딩(API/MinIO) 을 user-netdev 에 덧붙인다.
    qe.extra_netdev_args = "hostfwd=tcp::6443-:6443," \
                           "hostfwd=tcp::50090-:30900," \
                           "hostfwd=tcp::50091-:30901"
    # 추가 디스크(MinIO) + cloud-init seed 를 virtio-blk 로 첨부.
    # seed 는 iso9660(label=CIDATA) → cloud-init NoCloud 가 자동 인식.
    qe.extra_qemu_args = [
      "-drive", "if=none,id=minio,format=qcow2,file=#{DISK_IMG}",
      "-device", "virtio-blk-pci,drive=minio,serial=pepminio",
      "-drive", "if=none,id=seed,format=raw,file=#{SEED_IMG}",
      "-device", "virtio-blk-pci,drive=seed,serial=cidata",
    ]
  end

  # 프로비저닝: 공통 → bond → control-plane → 단일노드(untaint + 디스크).
  config.vm.provision "shell", path: "../scripts/common.sh",  args: [NODE_IP, ROOT_PASSWORD]
  config.vm.provision "shell", path: "../scripts/bond.sh",    args: [NODE_IP]
  config.vm.provision "shell", path: "../scripts/control-plane.sh", args: [NODE_IP]
  config.vm.provision "shell", path: "scripts/single-node.sh", args: [NODE_IP]
end
