# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Vagrant + kubeadm K8s 클러스터 (PEP 등록 + MinIO 용) — Apple Silicon 우선(VMware Fusion)
#
#  - OS: AlmaLinux 10 (RHEL 10 호환 — 커널 6.12, dnf/SELinux/firewalld/NetworkManager 동일)
#  - control-plane 1대 + worker N대 (기본 2대), CRI: CRI-O (pkgs.k8s.io)
#  - CNI: Cilium (cilium-cli, ipam=kubernetes → kubeadm PodCIDR 10.244.0.0/16, host-only 망 미충돌)
#  - PEP(docker-compose backend) 접속 지원:
#       * API 서버 6443 → Mac 호스트(0.0.0.0)로 포워딩
#       * apiserver 인증서 SAN 에 host.docker.internal 포함 (TLS 검증 정상)
#       * _out/pep-kubeconfig.yaml 자동 생성 (server=host.docker.internal:6443)
#  - worker 마다 10GB 추가 디스크 → /mnt/disks/minio 로 포맷/마운트 (MinIO 스토리지)
#
# 기동 (Apple Silicon, VMware Fusion):
#   vagrant up --provider=vmware_desktop
#   # 또는: export VAGRANT_DEFAULT_PROVIDER=vmware_desktop && vagrant up
#
# 기동 (Intel Mac / Linux / Windows, VirtualBox):
#   vagrant up --provider=virtualbox
#
# 요구: Vagrant 2.3+. Apple Silicon → VMware Fusion 13.5+ (개인용 무료) +
#       vagrant-vmware-desktop 플러그인 + vagrant-vmware-utility. (README 참고)
#
# ── 멀티 클러스터 ────────────────────────────────────────────────────────────────
# 폐쇄망 운영과 동일한 K8s 클러스터를 2개(이상) 띄워 PEP 멀티클러스터 테스트를 한다.
# 같은 디렉터리에서 PEP_CLUSTER 와 VAGRANT_DOTFILE_PATH 만 바꿔 독립 상태로 띄운다:
#
#   # 클러스터 1 (기본)
#   vagrant up --provider=virtualbox
#   # 클러스터 2 (다른 서브넷/포트/VM이름/산출물 — 상태 디렉터리도 분리)
#   #  PowerShell:  $env:PEP_CLUSTER=2; $env:VAGRANT_DOTFILE_PATH=".vagrant-c2"; vagrant up --provider=virtualbox
#   #  bash:        PEP_CLUSTER=2 VAGRANT_DOTFILE_PATH=.vagrant-c2 vagrant up --provider=virtualbox
#
# 프리셋(아래)은 개별 env 로 override 가능: NET_PREFIX / API_HOST_PORT / VBOX_PREFIX / OUT_NAME / NUM_WORKERS.

# ── 클러스터 프리셋 (PEP_CLUSTER=1|2 …) ──────────────────────────────────────────
CLUSTER = (ENV['PEP_CLUSTER'] || '1').to_s
# 클러스터별 기본값: host-only 서브넷·host 포워딩 포트·VirtualBox 이름·산출물 디렉터리를 분리.
PRESETS = {
  '1' => { net: '192.168.56', port: 6443, vbox: '',    out: '_out'    },
  '2' => { net: '192.168.57', port: 6444, vbox: 'c2-', out: '_out-c2' },
}
PRE = PRESETS[CLUSTER] || { net: "192.168.#{55 + CLUSTER.to_i}", port: 6442 + CLUSTER.to_i, vbox: "c#{CLUSTER}-", out: "_out-c#{CLUSTER}" }

# ── 설정 (env 로 override 가능) ──────────────────────────────────────────────────
BOX            = ENV['BOX'] || "almalinux/10"     # RHEL 10 호환. Apple Silicon 은 aarch64 변형 자동 선택.
NUM_WORKERS    = (ENV['NUM_WORKERS'] || '2').to_i
NET_PREFIX     = ENV['NET_PREFIX'] || PRE[:net]    # host-only 사설망 대역 (클러스터마다 분리)
API_HOST_PORT  = (ENV['API_HOST_PORT'] || PRE[:port]).to_i  # 6443 이 클러스터 간 충돌하므로 c2=6444
VBOX_PREFIX    = ENV['VBOX_PREFIX'] || PRE[:vbox]  # VirtualBox VM 이름 prefix (호스트 전역 고유)
OUT_NAME       = ENV['OUT_NAME'] || PRE[:out]      # 산출물 디렉터리(/vagrant/<OUT_NAME>) — 클러스터마다 분리
OUT_PATH       = "/vagrant/#{OUT_NAME}"
CP_IP          = "#{NET_PREFIX}.10"
WORKER_DISK_GB = 10                     # worker 추가 디스크 크기 (MinIO 용)
CP_MEM         = 2560
CP_CPUS        = 2
WORKER_MEM     = 2560
WORKER_CPUS    = 2
ROOT_PASSWORD  = "rootpass"             # 노드 root SSH 비번 (폐쇄망 동일 흐름 테스트용 — 운영 금지)

# Vagrant 네이티브 디스크 기능 (worker 추가 디스크 attach 에 사용)
ENV['VAGRANT_EXPERIMENTAL'] = 'disks'

# 사용 중인 provider 에 맞는 리소스 블록을 적용 (Vagrant 는 활성 provider 만 사용).
# vm_name 은 호스트 전역에서 고유해야 하므로 VBOX_PREFIX 를 붙인다(멀티클러스터 충돌 방지).
def set_provider(node, name, mem, cpus)
  vm_name = "#{VBOX_PREFIX}#{name}"
  # Apple Silicon 권장 — VMware Fusion
  node.vm.provider "vmware_desktop" do |v|
    v.gui = false
    v.vmx["displayName"] = vm_name
    v.vmx["memsize"]     = mem.to_s
    v.vmx["numvcpus"]    = cpus.to_s
  end
  # Apple Silicon 대안 — Parallels (vagrant-parallels 플러그인)
  node.vm.provider "parallels" do |prl|
    prl.name   = vm_name
    prl.memory = mem
    prl.cpus   = cpus
  end
  # Intel Mac / Linux / Windows — VirtualBox
  node.vm.provider "virtualbox" do |vb|
    vb.name   = vm_name
    vb.memory = mem
    vb.cpus   = cpus
  end
end

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false

  # ── Control-plane ──────────────────────────────────────────────────────────
  config.vm.define "k8s-control-1", primary: true do |cp|
    cp.vm.hostname = "k8s-control-1"
    cp.vm.network "private_network", ip: CP_IP

    # API 서버를 호스트로 노출 (host_ip 0.0.0.0 → host.docker.internal 도달).
    # 멀티클러스터: 클러스터마다 host 포트가 달라야 함(c1=6443, c2=6444 …). guest 는 항상 6443.
    # 주의: 호스트의 모든 인터페이스에 열리므로 신뢰된 로컬 환경에서만 사용.
    cp.vm.network "forwarded_port", guest: 6443, host: API_HOST_PORT, host_ip: "0.0.0.0", id: "k8s-api"

    set_provider(cp, "k8s-control-1", CP_MEM, CP_CPUS)

    cp.vm.provision "shell", path: "scripts/common.sh", args: [CP_IP, ROOT_PASSWORD]
    cp.vm.provision "shell", path: "scripts/bond.sh", args: [CP_IP]
    # control-plane.sh: [CP_IP, 산출물 디렉터리, PEP 접속용 host 포트]
    cp.vm.provision "shell", path: "scripts/control-plane.sh", args: [CP_IP, OUT_PATH, API_HOST_PORT.to_s]
  end

  # ── Workers ────────────────────────────────────────────────────────────────
  (1..NUM_WORKERS).each do |i|
    name = "k8s-worker-#{i}"
    ip   = "#{NET_PREFIX}.#{10 + i}"   # .11, .12, ...

    config.vm.define name do |w|
      w.vm.hostname = name
      w.vm.network "private_network", ip: ip

      # MinIO 용 추가 디스크 (worker 에만). 게스트에서 /dev/sdb(또는 nvme)로 보임.
      w.vm.disk :disk, size: "#{WORKER_DISK_GB}GB", name: "#{name}-minio"

      set_provider(w, name, WORKER_MEM, WORKER_CPUS)

      w.vm.provision "shell", path: "scripts/common.sh", args: [ip, ROOT_PASSWORD]
      w.vm.provision "shell", path: "scripts/bond.sh", args: [ip]
      # worker.sh: [worker IP, 산출물 디렉터리(join.sh 위치)]
      w.vm.provision "shell", path: "scripts/worker.sh", args: [ip, OUT_PATH]
    end
  end
end
