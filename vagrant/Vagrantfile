# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Vagrant + kubeadm K8s 클러스터 (PEP 등록 + MinIO 용)
#
#  - control-plane 1대 + worker N대 (기본 2대)
#  - CNI: Flannel (Pod CIDR 10.244.0.0/16 — host-only 망 192.168.56.x 와 미충돌)
#  - PEP(docker-compose backend) 가 접속할 수 있도록:
#       * API 서버 6443 → Mac 호스트(0.0.0.0)로 포워딩
#       * apiserver 인증서 SAN 에 host.docker.internal 포함 (TLS 검증 정상)
#       * _out/pep-kubeconfig.yaml 자동 생성 (server=host.docker.internal:6443)
#  - worker 마다 10GB 추가 디스크 → /mnt/disks/minio 로 포맷/마운트 (MinIO 스토리지)
#
# 사용법:
#   vagrant up
#   # 완료 후 _out/pep-kubeconfig.yaml 을 PEP "클러스터 추가" 에 붙여넣기
#   # API Endpoint: https://host.docker.internal:6443
#
# 요구: Vagrant 2.3+, VirtualBox 6.1+ (Intel Mac/Linux).
#       Apple Silicon 은 README 의 parallels/vmware 안내 참고.

# ── 설정 (필요시 수정) ─────────────────────────────────────────────────────────
BOX            = "bento/ubuntu-22.04"
NUM_WORKERS    = 2
NET_PREFIX     = "192.168.56"      # host-only 사설망 대역
CP_IP          = "#{NET_PREFIX}.10"
WORKER_DISK_GB = 10                # worker 추가 디스크 크기 (MinIO 용)
CP_MEM         = 2560
CP_CPUS        = 2
WORKER_MEM     = 2560
WORKER_CPUS    = 2

# Vagrant 네이티브 디스크 기능 (worker 추가 디스크 attach 에 사용)
ENV['VAGRANT_EXPERIMENTAL'] = 'disks'

Vagrant.configure("2") do |config|
  config.vm.box = BOX
  config.vm.box_check_update = false

  # ── Control-plane ──────────────────────────────────────────────────────────
  config.vm.define "k8s-control-1", primary: true do |cp|
    cp.vm.hostname = "k8s-control-1"
    cp.vm.network "private_network", ip: CP_IP

    # API 서버를 Mac 호스트로 노출 (host_ip 0.0.0.0 → host.docker.internal 도달 가능).
    # 주의: 6443 이 Mac 의 모든 인터페이스에 열리므로 신뢰된 로컬 환경에서만 사용.
    cp.vm.network "forwarded_port", guest: 6443, host: 6443, host_ip: "0.0.0.0", id: "k8s-api"

    cp.vm.provider "virtualbox" do |vb|
      vb.name   = "k8s-control-1"
      vb.memory = CP_MEM
      vb.cpus   = CP_CPUS
    end

    cp.vm.provision "shell", path: "scripts/common.sh", args: [CP_IP]
    cp.vm.provision "shell", path: "scripts/control-plane.sh", args: [CP_IP]
  end

  # ── Workers ────────────────────────────────────────────────────────────────
  (1..NUM_WORKERS).each do |i|
    name = "k8s-worker-#{i}"
    ip   = "#{NET_PREFIX}.#{10 + i}"   # .11, .12, ...

    config.vm.define name do |w|
      w.vm.hostname = name
      w.vm.network "private_network", ip: ip

      # MinIO 용 추가 디스크 (worker 에만). 게스트에서 /dev/sdb 로 보임.
      w.vm.disk :disk, size: "#{WORKER_DISK_GB}GB", name: "#{name}-minio"

      w.vm.provider "virtualbox" do |vb|
        vb.name   = name
        vb.memory = WORKER_MEM
        vb.cpus   = WORKER_CPUS
      end

      w.vm.provision "shell", path: "scripts/common.sh", args: [ip]
      w.vm.provision "shell", path: "scripts/worker.sh", args: [ip]
    end
  end
end
