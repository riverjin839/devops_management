# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/k8s_monitor
# SQLAlchemy 엔진 풀. backend/celery worker/beat 가 이 engine 코드를 공유하므로,
# replica 합계 × (POOL_SIZE+MAX_OVERFLOW) 가 Postgres max_connections 를 넘지 않게
# 배포별로 조정한다(k8s 매니페스트에서 worker/beat 는 더 작은 값으로 오버라이드).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
# 로컬 개발(DEBUG=true)에서는 기본값이 허용되지만, DEBUG=false(운영성 배포)로 띄우면
# 이 값이 기본값/32자 미만일 때 백엔드가 기동을 거부한다(main.py:_assert_secret_key_is_safe).
# 운영 배포 시 반드시 교체: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# Ansible
ANSIBLE_PLAYBOOK_DIR=/app/ansible/playbooks
ANSIBLE_INVENTORY_DIR=/app/ansible/inventory

# Health Check
CHECK_INTERVAL_MINUTES=5
CHECK_TIMEOUT_SECONDS=30

# Ollama (AI Agent)
# 폐쇄망에서 이미지에 모델을 bake-in한 경우, 실제 pull된 모델명으로 설정
# 예) qwen2.5:7b 이미지를 사용하는 경우:
#   OLLAMA_URL=http://ollama:11434
#   OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# ── LLM 게이트웨이 (bootstrap fallback — 운영 설정은 Settings → AI/LLM 탭) ──
# 사내 OpenAI-호환 LLM 서비스 연결 시 설정하면 internal-llm 프로필이 합성된다.
# LLM_API_BASE=http://llm-gw.corp.internal:8000
# LLM_API_KEY=
# LLM_MODEL=corp-qwen3-32b
# LLM_TIMEOUT=120
# 장애 분석 백엔드 (claude|local_llm|rule_based) — UI 설정이 우선, 이 값은 폴백
# ANALYZER_BACKEND=rule_based

# Observability / 알람 수신
# ALERT_INGEST_TOKEN: Alertmanager webhook · 사내 alert-forwarder 가 알람을 밀어넣을 때 쓰는
#   Bearer 토큰. **fail-closed** — 비워두면 /observability/alerts/ingest 가 503 으로 닫힌다
#   (설정을 깜빡했을 때 무인증 공개가 되지 않도록. KUBEWATCH_TOKEN 과 동일 정책).
#   생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ALERTMANAGER_URL: /observability 대시보드가 조회할 Alertmanager. 클러스터별로 다르면
#   클러스터 관리 → 정보 수정에서 클러스터마다 오버라이드한다.
ALERT_INGEST_TOKEN=
ALERTMANAGER_URL=http://alertmanager-operated.monitoring.svc:9093

# K8S 자원 관리(/k8s-allocation) 스냅샷 — 전체 목록은 docs/ENVIRONMENT.md
# K8S_ALLOC_SNAPSHOT_BACKEND: auto(Redis 되면 replica 간 공유, 아니면 메모리) | redis | memory
# K8S_ALLOC_COUNT_TERMINAL_PODS: 1(기본) — 종료 파드까지 순회해 POD 상태 카운트를 같은 스냅샷에서 계산
# K8S_ALLOC_SNAPSHOT_BACKEND=auto
# K8S_ALLOC_COUNT_TERMINAL_PODS=1

# Batch Jobs
# croniter 가 cron 식을 해석할 timezone (IANA name).
# 변경 시 기존 등록된 cron 잡들의 다음 발화 시각이 이동한다.
BATCH_JOBS_TIMEZONE=Asia/Seoul

# Debug — 로컬 개발 기본값은 true (docker-compose/kind/airgap overlay 와 동일).
# 운영 배포(prod overlay)는 false 로 설정하고 위 SECRET_KEY 를 반드시 교체해야 한다.
DEBUG=true
