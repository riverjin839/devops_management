# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/k8s_monitor

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# Ansible
ANSIBLE_PLAYBOOK_DIR=/app/ansible/playbooks
ANSIBLE_INVENTORY_DIR=/app/ansible/inventory

# Health Check
CHECK_INTERVAL_MINUTES=5
CHECK_TIMEOUT_SECONDS=30

# Ollama (AI Agent)
# 폐쇄망에서 이미지에 모델을 bake-in한 경우, 실제 pull된 모델명으로 설정
# 예) qwen2.5:7b 이미지를 사용하는 경우:
#   OLLAMA_URL=http://ollama:11434
#   OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Coroot (애플리케이션 APM — 별도 배포된 coroot 연동)
# 비워두면 APM 기능이 offline 으로 비활성화된다 (앱은 정상 동작).
# per-cluster project 매핑은 클러스터 관리 화면에서 설정한다.
# COROOT_URL=http://coroot.coroot.svc:8080
# COROOT_API_KEY=
# COROOT_TIMEOUT=10

# Batch Jobs
# croniter 가 cron 식을 해석할 timezone (IANA name).
# 변경 시 기존 등록된 cron 잡들의 다음 발화 시각이 이동한다.
BATCH_JOBS_TIMEZONE=Asia/Seoul

# Debug
DEBUG=false
