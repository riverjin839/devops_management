# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/k8s_monitor

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production

# Ansible
ANSIBLE_PLAYBOOK_DIR=/app/ansible/playbooks
ANSIBLE_INVENTORY_DIR=/app/ansible/inventory

# Health Check
CHECK_INTERVAL_MINUTES=5
CHECK_TIMEOUT_SECONDS=30

# Ollama (AI Agent)
# 폐쇄망에서 이미지에 모델을 bake-in한 경우, 실제 pull된 모델명으로 설정
# 예) qwen2.5:7b 이미지를 사용하는 경우:
#   OLLAMA_URL=http://ollama:11434
#   OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# Debug
DEBUG=false

# ─── Confluence (폐쇄망) ────────────────────────────────────
# Basic Auth 방식
# CONFLUENCE_URL=http://confluence.company.local
# CONFLUENCE_USERNAME=admin
# CONFLUENCE_PASSWORD=your-password
# PAT(Personal Access Token) 방식 — Basic Auth 보다 권장
# CONFLUENCE_PAT=your-personal-access-token
# 자체 서명 인증서 사용 시 False
# CONFLUENCE_VERIFY_SSL=true

# ─── Jira (폐쇄망) ──────────────────────────────────────────
# JIRA_URL=http://jira.company.local
# JIRA_USERNAME=admin
# JIRA_PASSWORD=your-password
# JIRA_PAT=your-personal-access-token
# JIRA_VERIFY_SSL=true
