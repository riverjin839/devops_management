# 이 파일은 템플릿입니다. 값을 채워 secret.yaml 로 복사한 뒤 kustomization.yaml 에 추가하세요.
#
#   cp secret.yaml.tmpl secret.yaml
#   # PEP_API_URL / PEP_CLUSTER / NODE_PARAM_INGEST_TOKEN 교체
#
# (secret.yaml 은 커밋하지 마세요 — 토큰이 들어갑니다)
apiVersion: v1
kind: Secret
metadata:
  name: node-param-agent-config
  namespace: k8s-monitor-agent
type: Opaque
stringData:
  PEP_API_URL: https://REPLACE-WITH-PEP/api/v1
  PEP_CLUSTER: REPLACE-WITH-CLUSTER-UUID
  NODE_PARAM_INGEST_TOKEN: REPLACE-WITH-NODE_PARAM_INGEST_TOKEN
  PEP_TLS_VERIFY: 'true'
