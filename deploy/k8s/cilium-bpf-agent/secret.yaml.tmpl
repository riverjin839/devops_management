# 이 파일은 템플릿입니다. 값을 채워 secret.yaml 로 복사한 뒤 kustomization.yaml 에 추가하세요.
#
#   cp secret.yaml.tmpl secret.yaml
#   # PEP_API_URL / PEP_CLUSTER / CILIUM_BPF_AGENT_TOKEN 교체
#
# (secret.yaml 은 커밋하지 마세요 — 토큰이 들어갑니다)
apiVersion: v1
kind: Secret
metadata:
  name: cilium-bpf-agent-config
  namespace: k8s-monitor-agent
type: Opaque
stringData:
  PEP_API_URL: https://REPLACE-WITH-PEP/api/v1
  PEP_CLUSTER: REPLACE-WITH-CLUSTER-UUID
  CILIUM_BPF_AGENT_TOKEN: REPLACE-WITH-CILIUM_BPF_AGENT_TOKEN
  PEP_TLS_VERIFY: 'true'
  # 사설 CA 로 서명된 PEP 인증서면 CA 를 볼륨으로 마운트하고 경로를 적는다.
  # PEP_CA_FILE: /etc/pep-ca/ca.crt
