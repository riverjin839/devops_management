        <mxCell id="ai-4" value="4. 조치 제안: SFP / 광 모듈 교체&#xa;+ 해당 포트 점검" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4D4D8;strokeColor=#18181B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
