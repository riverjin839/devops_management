          <mxGeometry x="1400" y="120" width="260" height="720" as="geometry" />
        </mxCell>

        <!-- ===== ① Sources ===== -->
        <mxCell id="src-router" value="Router / L3 Switch&#xa;(BGP peer)&#xa;&#xa;노출: ifHCIn/OutOctets,&#xa;ifIn/OutErrors, ifOperStatus,&#xa;BGP neighbor state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F3F46;strokeWidth=1.5;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="src-proto" value="프로토콜 · 검증 포트&#xa;SNMP  UDP 161&#xa;gNMI  gRPC 57400 (장비 의존)&#xa;BMP   TCP 5000&#xa;ICMP / TWAMP-Control TCP 862" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4E4E7;strokeColor=#52525B;strokeWidth=1;fontSize=11;fontColor=#27272A;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="src-endpoint" value="원격 엔드포인트 / 게이트웨이&#xa;(체감 품질 측정 대상)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F3F46;strokeWidth=1.5;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="450" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===== ② Collectors ===== -->
        <mxCell id="col-telegraf" value="telegraf-snmp&#xa;SNMP v2c 폴링 → /metrics :9273&#xa;(숫자 OID, MIB 비의존)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F3F46;strokeWidth=1.5;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="150" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="col-gnmic" value="gnmic&#xa;gNMI / OpenConfig 스트리밍(push)&#xa;→ prometheus output :9804" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F3F46;strokeWidth=1.5;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="240" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="col-bmp" value="openbmp-collector&#xa;BMP (RFC 7854) TCP 5000&#xa;peer up/down · route monitoring · withdraw" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F3F46;strokeWidth=1.5;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="330" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="col-blackbox" value="blackbox-exporter&#xa;ICMP/TCP 능동 프로브 → /probe :9115&#xa;probe_icmp_duration_seconds, probe_success" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3F3F46;strokeWidth=1.5;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="350" y="420" width="280" height="70" as="geometry" />
        </mxCell>

        <!-- ===== ③ Unified Store ===== -->
        <mxCell id="store-prom" value="Prometheus TSDB&#xa;&#xa;scrape: telegraf-snmp / gnmic / blackbox-icmp&#xa;&#xa;파생 recording rules:&#xa;net:probe_latency_ms:avg5m&#xa;net:probe_jitter_ms:stddev5m&#xa;net:probe_loss_ratio:5m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27272A;strokeWidth=2;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="150" width="240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="store-kafka" value="Kafka&#xa;:9092&#xa;&#xa;BMP route 이벤트 stream&#xa;(BGP withdraw / announce)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#27272A;strokeWidth=2;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="720" y="340" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="store-note" value="모든 계측 데이터가 단일 관측 평면(single store)으로 수렴" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontStyle=2;fontColor=#52525B;" vertex="1" parent="1">
          <mxGeometry x="720" y="470" width="240" height="40" as="geometry" />
        </mxCell>

        <!-- ===== ④ AI Reasoning chain ===== -->
        <mxCell id="ai-svc" value="PEP AI Agent — agent_service (Ollama)&#xa;입력: 지표 + route 이벤트 → 인과추론" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#18181B;strokeWidth=2;fontSize=11;fontStyle=1;fontColor=#18181B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="140" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ai-1" value="1. BGP withdraw 감지&#xa;(BMP route event)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#3F3F46;strokeWidth=1.5;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="210" width="280" height="56" as="geometry" />
        </mxCell>
        <mxCell id="ai-2" value="2. 동일 인터페이스 ifInErrors /&#xa;ifOutErrors 급증과 시계열 상관" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#3F3F46;strokeWidth=1.5;fontSize=11;fontColor=#18181B;align=left;spacingLeft=8;verticalAlign=middle;" vertex="1" parent="1">
